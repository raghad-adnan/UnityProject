<title>توثيق مشروع الدلو المتأرجح</title>
<style>
 body { font-family: 'Segoe UI','Arial',sans-serif; direction: rtl; text-align: right; font-size: 12pt; line-height: 1.6; color:#222; }
 h1 { color:#1F4E79; font-size:18pt; border-bottom:2px solid #1F4E79; padding-bottom:4px; margin-top:22px; }
 h2 { color:#2E74B5; font-size:14pt; margin-top:16px; }
 .title { text-align:center; color:#1F4E79; font-size:26pt; font-weight:bold; margin-bottom:4px; }
 .subtitle { text-align:center; color:#666; font-size:13pt; font-style:italic; margin-bottom:18px; }
 pre { direction: ltr; text-align: left; font-family: 'Consolas','Courier New',monospace; background:#F4F4F4; border:1px solid #ddd; font-size:10pt; padding:8px; white-space:pre-wrap; }
